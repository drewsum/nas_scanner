# Copy to .env and fill in. Every deployment-specific value lives here (never in code or
# compose files), so the same image runs on a dev machine and on TrueNAS.

# --- Database (PostgreSQL container) ---
POSTGRES_USER=nasscan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nasscan

# --- What to scan ---
# Host directory mounted read-only at /scan in the scanner (and clamd). On TrueNAS, a
# dataset path such as /mnt/tank; in dev, a sample folder.
NASSCAN_SCAN_ROOT=./samples
# When scans run (cron, container time zone): new and changed files nightly, every file weekly.
NASSCAN_INCREMENTAL_CRON="0 2 * * *"
NASSCAN_FULL_CRON="0 3 * * 0"
# Time zone for the schedules above and for times in reports.
TZ=America/New_York

# --- Web UI ---
# Password for the web UI and API. Blank leaves both open to anyone on the LAN.
NASSCAN_ADMIN_PASSWORD=
# Days a login lasts.
NASSCAN_SESSION_DAYS=30
# Reverse proxies to trust for X-Forwarded-For/-Proto (comma separated IPs or CIDRs), when
# serving the UI over HTTPS through one. Blank trusts none (only the container itself).
NASSCAN_TRUSTED_PROXIES=

# --- Backups (server stack: a dump into <NASSCAN_DATA_DIR>/backups) ---
NASSCAN_BACKUP_INTERVAL_HOURS=24
# How many dumps to keep; older ones are deleted.
NASSCAN_BACKUP_KEEP=14

# --- Host ports published by docker compose ---
NASSCAN_API_PUBLISH_PORT=8000
NASSCAN_WEB_PUBLISH_PORT=5173
# DB is published on loopback only, for local tools and tests.
NASSCAN_DB_PUBLISH_PORT=5434

# --- Server stack only (deploy/portainer-compose.yml) ---
# Host path of the app's own dataset; the DB lives in <this>/db, backups in <this>/backups.
# Keep it outside NASSCAN_SCAN_ROOT, or exclude it.
NASSCAN_DATA_DIR="/mnt/<pool>/<dataset>/nas_scanner"

NASSCAN_LOG_LEVEL=INFO
