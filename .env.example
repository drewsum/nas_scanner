# Copy to .env and fill in. Every deployment-specific value lives here (never in code or
# compose files), so the same image runs on a dev machine and on TrueNAS.

# --- Database (PostgreSQL container) ---
POSTGRES_USER=nasscan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nasscan

# --- What to scan ---
# Host directory mounted read-only at /scan in the scanner (and clamd). On TrueNAS, a
# dataset path such as /mnt/tank; in dev, a sample folder.
NASSCAN_SCAN_ROOT=./samples
# When scans run (cron, container time zone): new and changed files nightly, every file weekly.
NASSCAN_INCREMENTAL_CRON="0 2 * * *"
NASSCAN_FULL_CRON="0 3 * * 0"
# Paths to skip, comma separated. A name without a slash is skipped wherever it appears; a
# pattern with a slash matches the path under NASSCAN_SCAN_ROOT (* never spans a slash).
# Add the app's own dataset if it lives under the scan root, e.g. apps/nas_scanner.
NASSCAN_EXCLUDE_GLOBS='.zfs,ix-apps,.ix-apps,.ix-virt,.Trash-*,$RECYCLE.BIN,@eaDir'
# Files read in parallel, and the most they may read together in MB/s (0: no limit). Lower
# it if the NAS feels slow during scans.
NASSCAN_SCAN_WORKERS=2
NASSCAN_MAX_READ_MBPS=100
# The scanner lowers its CPU priority to this nice level (0-19), and its IO priority to idle.
NASSCAN_SCANNER_NICE=10
NASSCAN_SCANNER_IONICE_IDLE=true
# --- Engines ---
# Large media files (named like media and really media) over NASSCAN_LARGE_FILE_MB get only
# their first and last NASSCAN_PARTIAL_CHUNK_MB read and scanned, not the whole movie (and no
# hashes). Set NASSCAN_LARGE_MEDIA_FULL_READ=true to read them whole anyway.
NASSCAN_LARGE_FILE_MB=512
NASSCAN_PARTIAL_CHUNK_MB=16
NASSCAN_LARGE_MEDIA_FULL_READ=false
# Files up to this size are read into memory once and every engine scans that copy.
NASSCAN_MEMORY_READ_MB=64
# Folder names for media and documents: programs and scripts inside them are flagged.
#NASSCAN_MEDIA_FOLDERS=movies,tv,music,photos,documents,books,3d,...
# YARA rule sets downloaded daily (forge-core, forge-extended, forge-full, signature-base).
# Your own rules: mount a folder of .yar files at /rules in the scanner.
NASSCAN_YARA_SOURCES=forge-core
# Unofficial ClamAV signatures (clamd service): Sanesecurity's free sets on by default; paid
# MalwarePatrol and SecuriteInfo feeds turn on with their receipt/customer ID.
FANGFRISCH_SANESECURITY=yes
FANGFRISCH_MALWAREPATROL_RECEIPT=
FANGFRISCH_SECURITEINFO_CUSTOMER_ID=

# --- Threat intel (only hashes leave the NAS, never file contents) ---
# Hash feeds matched locally against every hashed file. malwarebazaar and threatfox need the
# abuse.ch key below; virusshare needs none (the newest NASSCAN_VIRUSSHARE_LISTS lists of
# 65,536 MD5s each in recent lists, about 10 MB of database per list).
NASSCAN_INTEL_FEEDS=malwarebazaar,threatfox,virusshare
NASSCAN_VIRUSSHARE_LISTS=16
# More hash lists by URL: name=url,name=url ({abusech_key} is filled in).
NASSCAN_INTEL_EXTRA_FEEDS=
# Live lookups, for executables, scripts, macro documents, archives and flagged files only.
# CIRCL (known-good files) and Team Cymru need no key and are on; the rest turn on with a key.
# NASSCAN_INTEL_DISABLED turns any of them off by name (circl, cymru, virustotal, ...).
NASSCAN_INTEL_LOOKUPS=true
NASSCAN_INTEL_DISABLED=
# Free keys: auth.abuse.ch (MalwareBazaar, ThreatFox, YARAify), virustotal.com,
# hybrid-analysis.com, metadefender.com, otx.alienvault.com, opentip.kaspersky.com.
NASSCAN_ABUSECH_AUTH_KEY=
NASSCAN_VIRUSTOTAL_API_KEY=
NASSCAN_HYBRID_ANALYSIS_API_KEY=
NASSCAN_METADEFENDER_API_KEY=
NASSCAN_OTX_API_KEY=
NASSCAN_OPENTIP_API_KEY=
# Daily budget and per-minute rate overrides, e.g. virustotal=500/4 (defaults fit free tiers).
NASSCAN_INTEL_LIMITS=

# Verdicts (docs/verdicts.md): per-engine weights, e.g. heuristics=0.5,virustotal=1.5, and the
# scores that make a file suspicious (40) or malicious (100).
NASSCAN_VERDICT_WEIGHTS=
NASSCAN_VERDICT_SUSPICIOUS_SCORE=40
NASSCAN_VERDICT_MALICIOUS_SCORE=100
NASSCAN_VERDICT_KNOWN_GOOD_FACTOR=0.5

# Time zone for the schedules above and for times in reports.
TZ=America/New_York

# --- Notifications and reports (docs/notifications.md) ---
# Apprise URLs, comma separated. Gmail: mailto://you:app-password@gmail.com (an app password,
# not your account password). Blank: no notifications. Reports are made either way.
NASSCAN_APPRISE_URLS=
# This app's address as you open it, so messages link to the finding (http://nas:8010).
NASSCAN_PUBLIC_URL=
# Alert on new findings at least this bad: suspicious or malicious.
NASSCAN_NOTIFY_MIN_VERDICT=suspicious
# Messages a rolling hour at most; more wait and go out together.
NASSCAN_NOTIFY_MAX_PER_HOUR=6
# A summary after every finished scan (failed scans always notify).
NASSCAN_NOTIFY_DIGEST=false
# Send the weekly report when it's made, after the scheduled full scan.
NASSCAN_NOTIFY_WEEKLY_REPORT=true

# --- Web UI ---
# Password for the web UI and API. Blank leaves both open to anyone on the LAN.
NASSCAN_ADMIN_PASSWORD=
# Days a login lasts.
NASSCAN_SESSION_DAYS=30
# Reverse proxies to trust for X-Forwarded-For/-Proto (comma separated IPs or CIDRs), when
# serving the UI over HTTPS through one. Blank trusts none (only the container itself).
NASSCAN_TRUSTED_PROXIES=

# --- Backups (server stack: a dump into <NASSCAN_DATA_DIR>/backups) ---
NASSCAN_BACKUP_INTERVAL_HOURS=24
# How many dumps to keep; older ones are deleted.
NASSCAN_BACKUP_KEEP=14

# --- Host ports published by docker compose ---
# 8010 by default: network_mapper already publishes 8000 on the same host.
NASSCAN_API_PUBLISH_PORT=8010
NASSCAN_WEB_PUBLISH_PORT=5173
# DB is published on loopback only, for local tools and tests.
NASSCAN_DB_PUBLISH_PORT=5434

# --- Server stack only (deploy/portainer-compose.yml) ---
# Host path of the app's own dataset; the DB lives in <this>/db, backups in <this>/backups.
# Keep it outside NASSCAN_SCAN_ROOT, or exclude it.
NASSCAN_DATA_DIR="/mnt/<pool>/<dataset>/nas_scanner"

NASSCAN_LOG_LEVEL=INFO
